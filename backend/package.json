{
  "name": "cha-ching-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state --var ENVIRONMENT:development --var PUBLIC_BASE_URL:http://127.0.0.1:8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "db:migrate:local": "wrangler d1 migrations apply cha-ching-prod --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply cha-ching-prod --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}
