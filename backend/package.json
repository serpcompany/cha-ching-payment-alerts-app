{
  "name": "cha-ching-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state --var ENVIRONMENT:development --var PUBLIC_BASE_URL:http://127.0.0.1:8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm db:seeds:assert-local-only",
    "db:migrate:local": "wrangler d1 migrations apply cha-ching-prod --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply cha-ching-prod --remote",
    "db:seed:dashboard:local": "wrangler d1 execute cha-ching-prod --local --persist-to .wrangler/state --file ./seeds/dashboard-v1.sql",
    "db:migrations:local:status": "wrangler d1 migrations list cha-ching-prod --local --persist-to .wrangler/state",
    "db:migrations:remote:status": "wrangler d1 migrations list cha-ching-prod --remote",
    "db:seeds:assert-local-only": "node scripts/no-remote-seeds.mjs",
    "promote:check": "pnpm check && pnpm exec wrangler types --check && pnpm exec wrangler deploy --dry-run && pnpm db:migrations:remote:status",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "better-auth": "1.6.26",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "miniflare": "5.20260801.1-alpha",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}
