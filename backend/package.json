{
  "name": "sales-ping-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "db:migrate:local": "wrangler d1 migrations apply sales-ping-prod --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply sales-ping-prod --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}
